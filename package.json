{
  "name": "@nuxtjs/hanko",
  "version": "2.0.0",
  "description": "Hanko integration for Nuxt",
  "keywords": [
    "authentication",
    "webauthn",
    "passkey",
    "hanko",
    "nuxt",
    "module",
    "nuxt-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nuxt-modules/hanko.git"
  },
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "typesVersions": {
    "*": {
      "dist/types.d.mts": [
        "./dist/types.d.mts"
      ]
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "pnpm build",
    "build": "nuxt-module-build prepare && nuxt-module-build build",
    "dev": "nuxt dev playground",
    "dev:nuxt5": "nuxt dev playground-nuxt5",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground && nuxt prepare playground-nuxt5",
    "release": "pnpm lint && pnpm test && bumpp && pnpm publish",
    "lint": "pnpm lint:all:eslint",
    "lint:all:eslint": "pnpm lint:eslint .",
    "lint:eslint": "eslint --fix",
    "test": "vitest run --coverage",
    "test:types": "tsc --noEmit",
    "test:watch": "vitest watch"
  },
  "dependencies": {
    "@nuxt/kit": "^4.5.2",
    "@teamhanko/hanko-elements": "^3.0.0",
    "defu": "^6.1.7",
    "jose": "^6.2.12",
    "ufo": "^1.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "@nuxt/module-builder": "1.0.3",
    "@nuxt/schema": "4.5.2",
    "@nuxt/test-utils": "4.3.2",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "bumpp": "12.3.0",
    "eslint": "10.10.0",
    "h3": "1.15.11",
    "hookable": "6.1.2",
    "nuxt": "4.5.2",
    "playwright": "1.63.0",
    "vitest": "5.0.1"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.21.0",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.4.1",
      "onFail": "download"
    }
  }
}
